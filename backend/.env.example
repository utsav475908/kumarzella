# Copy to backend/.env for native (non-Docker) development. Every setting is read from EL_* variables.
EL_ENVIRONMENT=development
EL_DATABASE_URL=postgresql+psycopg://tj:tj@localhost:5432/tradejournal
EL_REDIS_URL=redis://localhost:6379/0
# true = run background jobs inline (no worker needed); false = send large imports to Celery
EL_JOBS_EAGER=true
EL_STORAGE_BACKEND=local
EL_STORAGE_LOCAL_PATH=./var/storage
# Required in production: a long random value, and cookies marked Secure (HTTPS only)
EL_SECRET_KEY=dev-insecure-change-me
EL_COOKIE_SECURE=false
EL_LOG_JSON=true
# Historical market data: "dukascopy" (forex, needs outbound HTTPS to datafeed.dukascopy.com) or "none"
EL_MARKETDATA_PROVIDER=dukascopy
EL_DUKASCOPY_BASE_URL=https://datafeed.dukascopy.com/datafeed
# AI coach. Your own key for OpenAI or Anthropic; leave both empty to switch the coach off. Usage is billed to the key.
# EL_AI_PROVIDER=auto uses Anthropic when its key is set, otherwise OpenAI.
EL_AI_PROVIDER=auto
EL_OPENAI_API_KEY=
EL_OPENAI_MODEL=gpt-5.5
EL_ANTHROPIC_API_KEY=
EL_AI_MODEL=claude-opus-5-5
EL_AI_EFFORT=medium
