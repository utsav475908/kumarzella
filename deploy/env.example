# Copy to /opt/edgeledger/.env on the server and fill in. Never commit the real file.
EL_DOMAIN=edgeledger.example.com
# openssl rand -hex 32
EL_SECRET_KEY=
# openssl rand -hex 24   (set once, before the first start: Postgres keeps the password it was created with)
POSTGRES_PASSWORD=
# AI coach: your OpenAI API key (sk-...). Leave empty to keep the coach switched off.
OPENAI_API_KEY=
# Optional: OPENAI_MODEL (default gpt-5.5). To use Anthropic instead, set ANTHROPIC_API_KEY; if both keys are set,
# Anthropic is used unless AI_PROVIDER=openai.
# OPENAI_MODEL=gpt-5.5
# AI_PROVIDER=openai
# Where CircleCI publishes the images: ghcr.io/<your GitHub user, lower case>
IMAGE_REPO=ghcr.io/utsav475908
IMAGE_TAG=latest
