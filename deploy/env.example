# Copy to /opt/edgeledger/.env on the server and fill in. Never commit the real file.
EL_DOMAIN=edgeledger.example.com
# openssl rand -hex 32
EL_SECRET_KEY=
# openssl rand -hex 24   (set once, before the first start: Postgres keeps the password it was created with)
POSTGRES_PASSWORD=
# Where CircleCI publishes the images: ghcr.io/<your GitHub user, lower case>
IMAGE_REPO=ghcr.io/utsav475908
IMAGE_TAG=latest
