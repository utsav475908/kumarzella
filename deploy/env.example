# Copy to /opt/edgeledger/.env on the server and fill in. Never commit the real file.
EL_DOMAIN=edgeledger.example.com
# openssl rand -hex 32
EL_SECRET_KEY=
# openssl rand -hex 24   (set once, before the first start: Postgres keeps the password it was created with)
POSTGRES_PASSWORD=
# AI coach: your DeepSeek API key (sk-...). Leave empty to keep the coach switched off.
DEEPSEEK_API_KEY=
# Use DeepSeek even if another provider's key is also set.
AI_PROVIDER=deepseek
# Optional: DEEPSEEK_MODEL (default deepseek-chat). OPENAI_API_KEY (with AI_PROVIDER=openai) and ANTHROPIC_API_KEY
# (with AI_PROVIDER=anthropic) also work; see docs/ai-coach.md.
# DEEPSEEK_MODEL=deepseek-chat
# Where CircleCI publishes the images: ghcr.io/<your GitHub user, lower case>
IMAGE_REPO=ghcr.io/utsav475908
IMAGE_TAG=latest
